# Dronetag boot-pin convention. The application's device tree fills
# these aliases, each pointing at a node whose gpios cell 1 is the pin:
#   dt-status-led-red/-green/-blue   status LED
#   dt-factory-reset                 factory-reset input
# (Scout fills them from its overlays; the pins are defined once there.)
# An unfilled alias leaves its dt_pin_* variable unset and the guarded
# actions below skip that feature. fdt get value renders cells as
# 0x-hex; the gpio command wants decimal, hence setexpr fmt.
fdt addr ${fdt_addr}
if fdt get value dt_path /aliases dt-status-led-red; then
    if fdt get value dt_hex ${dt_path} gpios 1; then
        setexpr dt_pin_led_r fmt %d ${dt_hex}
    fi
fi
if fdt get value dt_path /aliases dt-status-led-green; then
    if fdt get value dt_hex ${dt_path} gpios 1; then
        setexpr dt_pin_led_g fmt %d ${dt_hex}
    fi
fi
if fdt get value dt_path /aliases dt-status-led-blue; then
    if fdt get value dt_hex ${dt_path} gpios 1; then
        setexpr dt_pin_led_b fmt %d ${dt_hex}
    fi
fi
if fdt get value dt_path /aliases dt-factory-reset; then
    if fdt get value dt_hex ${dt_path} gpios 1; then
        setexpr dt_pin_factory fmt %d ${dt_hex}
    fi
fi

# Turn on status LED (R+G) yellow to signal power on
if test -n "${dt_pin_led_r}"; then
    gpio set ${dt_pin_led_r}
    gpio set ${dt_pin_led_g}
    gpio clear ${dt_pin_led_b}
fi

run mender_setup
mmc dev ${mender_uboot_dev}

# Set the kernel load address high for (self-)extracting kernels
# so they don't override themselves not anything else. kernel_addr
# is 0x8000 and ramdisk_addr is (60MB) for LUKS. Hence we need to
# load the kernel so even big ramdisk won't override it. 115MB for a
# ramdisk should be fine
env set kernel_addr_r 0x10000000
env set boot_script_addr 0x0F000000

setenv boot_config "@@UBOOT_BOOT_CONFIGURATION@@"

if test -z "${bootargs}"; then
    setenv bootargs ""
fi

# Configure the factory-reset GPIO as input and read it
setenv gpio_factory_val ""
if test -n "${dt_pin_factory}"; then
    gpio input ${dt_pin_factory}
    gpio read gpio_factory_val ${dt_pin_factory}
    gpio clear ${dt_pin_factory}
fi

# Check if GPIO is LOW or factoryreset env var is set
if test "${gpio_factory_val}" = "0" || test -n "${factoryreset}"; then
    echo "Factory reset triggered"
    setenv bootargs "${bootargs} rootrwreset factoryreset"

    # If factoryreset env var is set, clear and save it
    if test -n "${factoryreset}"; then
        echo "Clearing factoryreset env variable..."
        setenv factoryreset
        saveenv
    fi
fi

setexpr mender_kernel_part ${mender_boot_part} + @@KERNELFS_OFFSET_TO_ROOTFS@@
setexpr mender_kernel_part_hex ${mender_boot_part_hex} + @@KERNELFS_OFFSET_TO_ROOTFS@@
env set mender_kernel_part_root mmc 0:${mender_kernel_part}

load ${mender_kernel_part_root} ${kernel_addr_r} /@@KERNEL_IMAGETYPE@@

imxtract ${kernel_addr_r} bootscr-boot.scr ${boot_script_addr}
source ${boot_script_addr}

# Kernel load failed: status LED to solid red
if test -n "${dt_pin_led_r}"; then
    gpio set ${dt_pin_led_r}
    gpio clear ${dt_pin_led_g}
    gpio clear ${dt_pin_led_b}
fi

# You can get to console by sending password (configured in CONFIG_AUTOBOOT_STOP_STR_CRYPT)
# and saved in shared Hardware keypass.
# TODO: Enable this in DEBUG mode
# Restore the Console so we can access it
# setenv silent 0
# setenv stderr serial
# setenv stdin serial
# setenv stdout serial

run mender_try_to_recover
